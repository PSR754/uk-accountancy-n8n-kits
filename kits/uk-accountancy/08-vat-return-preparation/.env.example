# Workflow configuration values referenced by this kit's workflow.json.
# These are NOT n8n credentials — the accounting API token and SMTP/email
# credentials are configured separately in n8n's built-in credential store
# (this token value is shown here only as a placeholder for reference).

# Base URL of your accounting/bookkeeping system's REST API
ACCOUNTING_API_BASE_URL=https://api.youraccountingsoftware.com/v1

# API token for the accounting system (store as an n8n credential where possible)
ACCOUNTING_API_TOKEN=your_api_token_here

# VAT period being prepared (ISO dates)
VAT_PERIOD_START=2026-07-01
VAT_PERIOD_END=2026-09-30

# Client name, used in the draft email subject line
CLIENT_NAME=Example Client Ltd

# Sender and reviewer addresses
PRACTICE_SENDER_EMAIL=vat@yourpractice.co.uk
REVIEWING_ACCOUNTANT_EMAIL=reviewer@yourpractice.co.uk

# Anomaly detection thresholds
LARGE_TRANSACTION_THRESHOLD=10000
VAT_NUMBER_CHECK_THRESHOLD=135
