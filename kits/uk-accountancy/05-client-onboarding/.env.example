# === Workflow configuration ===
# Your firm's display name, used in email copy
FIRM_NAME=Your Accountancy Firm

# "From" address used on outgoing onboarding emails
SENDER_EMAIL=onboarding@youraccountancyfirm.co.uk

# Google Sheet ID for the client register (tab: "Client Register")
CLIENT_REGISTER_SHEET_ID=

# === NOT used as env vars — configured separately in n8n ===
# The Google Sheets credential and the Email Send (SMTP/Gmail) credential
# are configured via n8n's Credentials store and attached to their nodes
# there. The Form Trigger node itself needs no credential — it generates a
# public form URL once the workflow is active.
