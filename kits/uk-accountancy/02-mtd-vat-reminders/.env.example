# === Workflow configuration ===
# Google Sheet ID with two tabs: "VAT Clients" (Client Name, Contact Email,
# VAT Quarter End, Submitted, Last Checklist Sent) and "Submission Log"
MTD_VAT_CLIENTS_SHEET_ID=

# "From" address used on outgoing checklist emails
SENDER_EMAIL=vat-reminders@youraccountancyfirm.co.uk

# Days-before-deadline milestones for sending the pre-submission checklist
CHECKLIST_MILESTONE_DAYS=21,14,7,3

# === NOT used as env vars — configured separately in n8n ===
# Google Sheets and Email Send (SMTP/Gmail) credentials are attached to the
# relevant nodes via n8n's own Credentials store, not via this file.
