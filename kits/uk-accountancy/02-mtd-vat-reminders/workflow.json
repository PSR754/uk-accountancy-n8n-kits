    "Send Checklist Email": {
      "main": [[{ "node": "Log Checklist Sent", "type": "main", "index": 0 }]]
    },
    "Filter: Newly Submitted": {
      "main": [[{ "node": "Log Submission Confirmation", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "id": "mtd-vat-reminders-002",
  "tags": ["uk-accountancy", "vat", "mtd"]
