# Workflow configuration values referenced by this kit's workflow.json.
# These are NOT n8n credentials — credentials (Google Sheets OAuth, SMTP, etc.)
# are configured separately in n8n's built-in credential store.

# Google Sheet ID containing the "Checklist" tab (Client, Client Email, Job Type,
# Document Name, Received, Date Requested, Date Received)
DOCUMENT_CHECKLIST_SHEET_ID=your_google_sheet_id_here

# Email address the chase emails are sent from
PRACTICE_SENDER_EMAIL=documents@yourpractice.co.uk

# How often (days) the chase schedule trigger fires
CHASE_INTERVAL_DAYS=3
