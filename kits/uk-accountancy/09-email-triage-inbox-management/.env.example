# Workflow configuration values referenced by this kit's workflow.json.
# These are NOT n8n credentials — the IMAP/Gmail mailbox credential and SMTP
# credential are configured separately in n8n's built-in credential store.

# Google Sheet ID containing the "Inbox Log" tab
INBOX_LOG_SHEET_ID=your_google_sheet_id_here

# Comma-separated list of domains belonging to known clients (used to classify
# "Client Query" emails)
KNOWN_CLIENT_DOMAINS=clientone.co.uk,clienttwo.com

# Comma-separated list of keywords that trigger an urgent alert
URGENT_KEYWORDS=urgent,deadline,hmrc investigation,penalty

# Sender address for outbound alerts, and the practice manager's inbox
PRACTICE_SENDER_EMAIL=inbox-alerts@yourpractice.co.uk
PRACTICE_MANAGER_EMAIL=manager@yourpractice.co.uk
