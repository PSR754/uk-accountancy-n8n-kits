# Workflow configuration values referenced by this kit's workflow.json.
# These are NOT n8n credentials — Google Sheets and SMTP/Email credentials
# are configured separately in n8n's built-in credential store.

# Google Sheet ID containing the "Client Queries" tab
CLIENT_QUERIES_SHEET_ID=your_google_sheet_id_here

# Comma-separated staff email addresses used for round-robin assignment
STAFF_ROTATION=staff1@yourpractice.co.uk,staff2@yourpractice.co.uk,staff3@yourpractice.co.uk

# SLA targets, in business days
SLA_URGENT_DAYS=1
SLA_NORMAL_DAYS=3

# How many hours before the Due By deadline counts as "approaching" for the SLA check
SLA_WARNING_HOURS=4

# Sender address for acknowledgement/alert emails, and manager's inbox for SLA alerts
PRACTICE_SENDER_EMAIL=queries@yourpractice.co.uk
PRACTICE_MANAGER_EMAIL=manager@yourpractice.co.uk
