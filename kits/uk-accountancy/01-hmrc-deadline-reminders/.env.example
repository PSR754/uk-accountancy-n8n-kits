# === Workflow configuration (used directly by nodes in workflow.json) ===
# Google Sheet ID containing the client deadline tracker (columns: Client Name,
# Deadline Type, Due Date, Contact Email, Status, Last Reminder Sent)
HMRC_CLIENT_LIST_SHEET_ID=

# "From" address used on outgoing reminder emails
SENDER_EMAIL=reminders@youraccountancyfirm.co.uk

# Comma-separated days-before-due milestones at which reminders fire
# (matches the defaults baked into the Code node; change both together)
REMINDER_MILESTONE_DAYS=30,14,7,1

# === NOT used as env vars — configured separately in n8n ===
# The Google Sheets and Email Send (SMTP/Gmail) nodes each require an n8n
# credential set up via the n8n UI (Credentials > New). This .env file only
# covers the workflow's own configuration values (sheet IDs, addresses,
# thresholds) — it is not a substitute for those credentials.
