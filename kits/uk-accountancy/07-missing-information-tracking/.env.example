# Workflow configuration values referenced by this kit's workflow.json.
# These are NOT n8n credentials — credentials (Google Sheets OAuth, SMTP, etc.)
# are configured separately in n8n's built-in credential store.

# Google Sheet ID containing the "Outstanding Queries" tab
OUTSTANDING_QUERIES_SHEET_ID=your_google_sheet_id_here

# Email address notifications are sent from
PRACTICE_SENDER_EMAIL=queries@yourpractice.co.uk

# Practice manager's email, used for the top-level escalation path
PRACTICE_MANAGER_EMAIL=manager@yourpractice.co.uk

# Days a query can stay open before notifying the assigned staff member
ESCALATE_STAFF_DAYS=5

# Days a query can stay open before escalating to the practice manager
ESCALATE_MANAGER_DAYS=10
