{
  "name": "Missing Information Tracker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "b2b2b2b2-0001-4000-8000-000000000001",
      "name": "Daily Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $env.OUTSTANDING_QUERIES_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Outstanding Queries",
          "mode": "name"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0002-4000-8000-000000000002",
      "name": "Read Outstanding Queries",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [560, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1c1c1c1-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "Resolved",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0003-4000-8000-000000000003",
      "name": "Filter Open Queries",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "jsCode": "// Compute days open and escalation level for each open query\nconst ESCALATE_STAFF_DAYS = Number($env.ESCALATE_STAFF_DAYS || 5);\nconst ESCALATE_MANAGER_DAYS = Number($env.ESCALATE_MANAGER_DAYS || 10);\nconst now = new Date();\n\nreturn $input.all().map(item => {\n  const raised = new Date(item.json['Raised Date']);\n  const daysOpen = Math.floor((now - raised) / (1000 * 60 * 60 * 24));\n  let escalation = 'none';\n  if (daysOpen >= ESCALATE_MANAGER_DAYS) escalation = 'manager';\n  else if (daysOpen >= ESCALATE_STAFF_DAYS) escalation = 'staff';\n\n  return {\n    json: {\n      ...item.json,\n      daysOpen,\n      escalation\n    }\n  };\n});"
      },
      "id": "b2b2b2b2-0004-4000-8000-000000000004",
      "name": "Compute Days Open & Escalation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "d1d1d1d1-0001-4000-8000-000000000001",
                    "leftValue": "={{ $json.escalation }}",
                    "rightValue": "manager",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Escalate to Manager"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "d1d1d1d1-0002-4000-8000-000000000002",
                    "leftValue": "={{ $json.escalation }}",
                    "rightValue": "staff",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Notify Assigned Staff"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "b2b2b2b2-0005-4000-8000-000000000005",
      "name": "Route By Escalation Level",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.PRACTICE_SENDER_EMAIL }}",
        "toEmail": "={{ $json['Assigned To Email'] }}",
        "subject": "=Query still open: {{ $json.Client }} - {{ $json.Job }}",
        "emailFormat": "text",
        "text": "=This query has been open {{ $json.daysOpen }} days:\n\nClient: {{ $json.Client }}\nJob: {{ $json.Job }}\nQuery: {{ $json.Query }}\n\nPlease action or update its status.",
        "options": {}
      },
      "id": "b2b2b2b2-0006-4000-8000-000000000006",
      "name": "Notify Assigned Staff",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1680, 220]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.PRACTICE_SENDER_EMAIL }}",
        "toEmail": "={{ $env.PRACTICE_MANAGER_EMAIL }}",
        "subject": "=ESCALATION: Query open {{ $json.daysOpen }} days - {{ $json.Client }}",
        "emailFormat": "text",
        "text": "=The following query has breached the escalation threshold and needs manager attention:\n\nClient: {{ $json.Client }}\nJob: {{ $json.Job }}\nQuery: {{ $json.Query }}\nAssigned To: {{ $json['Assigned To'] }}\nDays Open: {{ $json.daysOpen }}",
        "options": {}
      },
      "id": "b2b2b2b2-0007-4000-8000-000000000007",
      "name": "Escalate to Manager",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1680, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e1e1e1e1-0001-4000-8000-000000000001",
              "leftValue": "={{ $json['Needs Client Input'] }}",
              "rightValue": "Y",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2b2b2-0008-4000-8000-000000000008",
      "name": "Needs Client Input?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1680, 540]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.PRACTICE_SENDER_EMAIL }}",
        "toEmail": "={{ $json['Client Email'] }}",
        "subject": "=Information needed: {{ $json.Job }}",
        "emailFormat": "text",
        "text": "=Dear {{ $json.Client }},\n\nWe still need the following to progress your {{ $json.Job }}:\n\n{{ $json.Query }}\n\nPlease reply at your earliest convenience.\n\nMany thanks,\nThe Practice Team",
        "options": {}
      },
      "id": "b2b2b2b2-0009-4000-8000-000000000009",
      "name": "Send Client Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1960, 540]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $env.OUTSTANDING_QUERIES_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Outstanding Queries",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Days Open": "={{ $json.daysOpen }}",
            "Last Escalated": "={{ $now.toISODate() }}"
          },
          "matchingColumns": ["Client", "Job", "Query"]
        },
        "options": {}
      },
      "id": "b2b2b2b2-0010-4000-8000-000000000010",
      "name": "Update Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1960, 300]
    }
  ],
