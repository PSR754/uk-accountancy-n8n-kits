# ---------------------------------------------------------------------------
# Invoice chasing: configuration
#
# Every value here is read by the "Build Config" node. If a value is missing,
# the default shown in the comment is used, so a half-filled file still runs.
#
# Self-hosted n8n only reads these when N8N_BLOCK_ENV_ACCESS_IN_NODE=false.
# On n8n Cloud, $env is not available to Code nodes at all: edit the defaults
# at the top of the "Build Config" node instead. The kit is built so that
# every one of these has a working default, for exactly that reason.
# ---------------------------------------------------------------------------

# --- SAFETY -----------------------------------------------------------------
# While DRY_RUN is anything other than the exact string "false", no client can
# receive anything: every chase email is delivered to DRY_RUN_RECIPIENT with the
# real recipient shown in the subject line.
# Leave this on until you have read a full week of previews and are happy.
DRY_RUN=true
DRY_RUN_RECIPIENT=you@yourfirm.co.uk

# Where the 08:30 preview and any alerts are sent.
PRACTICE_EMAIL=you@yourfirm.co.uk

# --- Identity ---------------------------------------------------------------
FIRM_NAME=Your Firm Ltd
SENDER_NAME=Accounts
SENDER_EMAIL=accounts@yourfirm.co.uk
# Replies go here. Use a mailbox a person actually reads.
REPLY_TO_EMAIL=accounts@yourfirm.co.uk
# Printed in the footer so a client can verify anything by phone.
FIRM_PHONE=01234 567890
# The name the emails are signed with. Defaults to SENDER_NAME.
SIGN_OFF_NAME=

# Optional. Shown under "How to pay" in every chase email.
# Use \n for line breaks, and always tell them to quote the invoice number.
PAYMENT_INSTRUCTIONS=

# --- The chase ladder -------------------------------------------------------
# Days overdue at which each stage becomes due.
CHASE_FRIENDLY_DAYS=7
CHASE_FIRM_DAYS=30
CHASE_FINAL_DAYS=60

# Never two chase emails to the same client closer together than this.
MIN_DAYS_BETWEEN_CHASES=7

# If a run would send more than this, it sends nothing and tells you instead.
# The usual cause of a sudden jump is an accidental edit to the sheet.
MAX_EMAILS_PER_RUN=50

# --- Tone and calendar ------------------------------------------------------
# The Late Payment of Commercial Debts (Interest) Act 1998 covers business
# debts only. This kit never sends that wording to a client marked Individual.
# Set to false to remove it from business emails too.
MENTION_LATE_PAYMENT_ACT=true

SEND_ON_WEEKENDS=false
SEND_ON_BANK_HOLIDAYS=false

# --- The sheet --------------------------------------------------------------
# The Google Sheet holding the Invoices, Sent Log, Run Log and Run Control tabs.
# Take the id from the sheet URL, between /d/ and /edit.
INVOICE_TRACKER_SHEET_ID=

# Optional. A link in the 08:30 preview that stops that day's 09:00 run.
# Leave blank until you have set up the hold webhook.
HOLD_URL=

# --- Not environment variables ----------------------------------------------
# The Google Sheets credential and the SMTP or Gmail credential are attached to
# their nodes in n8n's own credential store. They never appear in this file.
