# ---------------------------------------------------------------------------
# Companies House deadline tracker: configuration
#
# Every value here is read by the "Build Config" node. If a value is missing,
# the default shown in the comment is used, so a half-filled file still runs.
#
# Self-hosted n8n only reads these when N8N_BLOCK_ENV_ACCESS_IN_NODE=false.
# On n8n Cloud, $env is not available to Code nodes at all: edit the defaults
# at the top of the "Build Config" node instead.
# ---------------------------------------------------------------------------

# --- SAFETY -----------------------------------------------------------------
# While DRY_RUN is anything other than the exact string "false", the digest is
# labelled as a preview, goes to DRY_RUN_RECIPIENT, and nothing is recorded in
# the Sent Log. Leave it on until you have read a week of digests and agree with
# them. This kit never emails a client and never files anything either way.
DRY_RUN=true
DRY_RUN_RECIPIENT=you@yourfirm.co.uk

# Where the digest goes when dry run is off.
PRACTICE_EMAIL=you@yourfirm.co.uk

# --- Identity ---------------------------------------------------------------
FIRM_NAME=Your Firm Ltd
SENDER_EMAIL=accounts@yourfirm.co.uk

# --- Reminders --------------------------------------------------------------
# Days before a deadline at which a reminder is raised. Comma separated.
REMINDER_MILESTONES=30,14,7,1
# After a deadline has passed, remind again every this many days.
OVERDUE_REPEAT_DAYS=7
# Day (0 = Sunday, 1 = Monday) when a digest is sent even if no reminder is due,
# so rows that need checking are not forgotten. Use "off" to disable.
ATTENTION_DIGEST_WEEKDAY=1
# Put a draft client message under each reminder. It is text in your digest for
# a person to review and send; the workflow never sends it.
INCLUDE_CLIENT_DRAFTS=true

# --- The sheet --------------------------------------------------------------
# The Google Sheet holding the Companies, Sent Log and Run Log tabs.
# Take the id from the sheet URL, between /d/ and /edit.
COMPANIES_HOUSE_TRACKER_SHEET_ID=

# --- Not environment variables ----------------------------------------------
# The Companies House API key (an HTTP Basic Auth credential with the key as the
# username and an empty password), the Google Sheets credential and the SMTP or
# Gmail credential are attached to their nodes in n8n's own credential store.
# They never appear in this file.
