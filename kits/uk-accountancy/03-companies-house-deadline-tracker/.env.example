# === Workflow configuration ===
# Google Sheet ID with a "Companies" tab: Company Name, Company Number,
# Confirmation Statement Due, Accounts Due, Contact Email
COMPANIES_HOUSE_TRACKER_SHEET_ID=

# "From" address used on outgoing reminder emails
SENDER_EMAIL=compliance@youraccountancyfirm.co.uk

# Internal mailbox that receives deadline reminder digests
COMPLIANCE_TEAM_EMAIL=compliance-team@youraccountancyfirm.co.uk

# Companies House public API key (register at
# https://developer.company-information.service.gov.uk/). The API uses HTTP
# Basic Auth with the API key as the username and an empty password.
COMPANIES_HOUSE_API_KEY=

# === NOT used as env vars — configured separately in n8n ===
# The Google Sheets credential and the HTTP Basic Auth credential (holding
# COMPANIES_HOUSE_API_KEY) are both configured in n8n's Credentials store and
# attached to their respective nodes there, not read from this file directly.
